{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = true ]; then sh \"$CLAUDE_PROJECT_DIR/tools/cloud_session_setup.sh\"; fi",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
